# Dependencies
node_modules/

# Secrets. A live API key sat in a tracked corpus file for days; nothing shaped like
# a credential file should reach the index even by accident.
.env
.env.*

# Python: the needle sidecar venv
.venv/
__pycache__/
*.pyc

# Miner output — regenerable from ~/.pi/agent/sessions
mine/out/

# Scratch files from ticks and benchmark runs
bench/results/*.tmp
*.tmp

# Engine and model caches live outside the repo (~/.cache/cactus-needle,
# ~/.cache/huggingface); nothing from them is ever staged.
.cache/
finetune/checkpoints/

# Generated fine-tune artifacts (`make data/train/build`).
finetune/out/

# The mined corpus and the bench task set are private research data: they carry
# session text, addresses and terminal output from real work. The harness, the
# schema and the records ship — the rows they were measured on do not. A record
# cites its task-set sha and is re-scorable against a copy supplied out of band.
bench/tasks/*.jsonl

# Trainer scratch dirs created by ad-hoc probes
checkpoints/
lora-*.safetensors

# Bench traces. A trace row carries the model's own sentence, and for any model that
# answers rather than refusing that sentence is the tail's words rearranged — session
# text in a tracked file, which docs/CORPUS-POLICY.md forbids. The record keeps the
# scores and the task-set sha; the trace stays on disk beside the corpus it came from.
# The needle3 traces already tracked predate this rule and are clean by construction:
# that engine refused every row, so its argument is one of the adapter's constants.
bench/results/*.traces.jsonl

# The slate runner copies each variant's task set here before scoring it. Those
# copies are session text, so the directory is ignored even though it sits inside
# the records tree (docs/CORPUS-POLICY.md §1).
bench/results/.slate-scratch/

# Editor and manual backups: never published.
*.bak
*.bak-*
